// ============================================================// 姣忔棩鏁版嵁閲囬泦缂栨帓锛堟柟妗堢涓冩锛?// 娴佺▼锛氭暟鎹簮 鈫?collector 鈫?cleaner(鏍囧噯鍖? 鈫?鏁版嵁搴?鈫?璁＄畻琛嶇敓鎸囨爣// 骞傜瓑锛氬悓涓€澶╅噸澶嶆墽琛屼細鍏堝垹鍚庡啓// 鎵ц鏂瑰紡锛歜un scripts/collect-daily.ts锛堝搴旀柟妗堜腑鐨?python collect_daily.py锛?// ============================================================import { db } from "@/lib/db";import { fetchAllPools, type EmPoolStock } from "@/lib/market/em";import {  fetchAllStockSnapshot,  fetchAllIndexKlines,  fetchKlineBatch,  type TxDailyBar,  type TxRankRow,  type IndexSeries,} from "@/lib/market/tx";import {  detectBarStatus,  limitUpPriceOf,  limitDownPriceOf,  limitPctOf,  marketOf,  txCode,} from "@/lib/market/rules";import { computeBoardChain, type BoardState } from "@/lib/calc/board";import { calcSentiment, sealRateOf, brokenRateOf } from "@/lib/calc/sentiment";import { buildConceptStats, buildThemeStats } from "@/lib/calc/concept";import {  matchThemes,  matchThemesInTextDetailed,  normalizeStockName,} from "@/lib/calc/themeRules";import { analyzeImpact } from "@/lib/calc/newsImpact";import { fetchStockNews, type StockNewsItem } from "@/lib/market/stockNews";import { pmap, sleep } from "@/lib/market/http";import { createHash } from "node:crypto";import { nameAbbrOf } from "@/lib/calc/pinyin";export interface CollectOptions {  backfillDays?: number; // 鍥炶ˉ鐨勪氦鏄撴棩鏁伴噺锛堥粯璁?0锛?  preWindowDays?: number; // 绐楀彛鍓嶇瀛愬ぉ鏁帮紙淇濊瘉杩炴澘閾捐矾杩涘叆绐楀彛鏃跺熀鏁版纭級  preWindowDays?: number; // chuangKouQianZhongZiTianShu  klineBars?: number; // 姣忓彧鑲＄エ鎷夊彇鐨凨绾挎牴鏁?}export interface CollectSummary {  latestDate: string;  tradeDates: string[];  stockCount: number;  limitUpCount: number;  brokenCount: number;  limitDownCount: number;  firstBoardCount: number;  lianbanCount: number;  highestBoard: number;  totalAmountYi: number;  upCount: number;  downCount: number;  sealRate: number;  temperature: number;  stage: string;  boardMismatch: number; // 鑷富杩炴澘鏁?涓?鏁版嵁婧愬弬鑰冭繛鏉挎暟 涓嶄竴鑷存暟閲忥紙浜ゅ弶楠岃瘉瑙傛祴锛?  stockNewsCount: number; // 鏈€鏂颁氦鏄撴棩娑ㄥ仠鑲′釜鑲℃柊闂诲叆搴撴潯鏁帮紙涓荤嚎鏂伴椈娴侊級  evidenceStocks: number; // 鏈夋柊闂诲綊绫昏瘉鎹殑娑ㄥ仠鑲℃暟  themeMerged: number; // 鏂伴椈璇佹嵁鏂板鐨勪富绾垮綊灞炲鏁?  durationMs: number;}function chunk<T>(arr: T[], size: number): T[][] {  const out: T[][] = [];  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));  return out;}/** 瑙ｆ瀽 JSON 瀛楃涓蹭负涓婚鏉愭暟缁勶紙闃插尽寮忥級 */function parseThemes(s: string | null | undefined): string[] {  if (!s) return [];  try {    const v = JSON.parse(s);    return Array.isArray(v) ? v.map(String) : [];  } catch {    return [];  }}interface KlineMeta {  bars: TxDailyBar[];  barByDate: Map<string, TxDailyBar>;}/** * 閲忔瘮 = 褰撴棩鎴愪氦閲?/ 鍓?N 鏃ュ潎閲忥紙鐖嗛噺浣撶郴鏍稿績瀹氫箟锛岄粯璁?N=20锛? * 鍘嗗彶涓嶈冻 N 鏃ユ椂鐢ㄥ彲鐢ㄥぉ鏁帮紙鑷冲皯 5 鏃ワ紝鍚﹀垯杩斿洖 null锛? */function volumeRatioAt(meta: KlineMeta | undefined, date: string, window = 20): number | null {  if (!meta) return null;  const idx = meta.bars.findIndex((b) => b.date === date);  if (idx < 0) return null;  const prevBars = meta.bars.slice(Math.max(0, idx - window), idx);  if (prevBars.length < 5) return null;  const avg = prevBars.reduce((s, b) => s + b.volume, 0) / prevBars.length;  if (avg <= 0) return null;  return Math.round((meta.bars[idx].volume / avg) * 100) / 100;}export async function runCollection(opts: CollectOptions = {}): Promise<CollectSummary> {  const startedAt = Date.now();  const backfillDays = opts.backfillDays ?? 10;  const preWindowDays = opts.preWindowDays ?? 12;  const klineBars = opts.klineBars ?? 80;  // ---------- 1. 鍏ㄥ競鍦哄揩鐓э紙鑵捐锛夛細娑ㄨ穼瀹舵暟 / 鎴愪氦棰?/ 鍚嶇О琛?----------  console.log("[1/7] 鎷夊彇鍏ㄥ競鍦篈鑲″揩鐓?...");  const snapshot = await fetchAllStockSnapshot(200);  if (snapshot.length === 0) throw new Error("鍏ㄥ競鍦哄揩鐓ц幏鍙栧け璐?);  const snapByCode = new Map<string, TxRankRow>(snapshot.map((r) => [r.code, r]));  const nameMap = new Map<string, string>(snapshot.map((r) => [r.code, r.name]));  const upCount = snapshot.filter((r) => r.changePct > 0).length;  const downCount = snapshot.filter((r) => r.changePct < 0).length;  const flatCount = snapshot.filter((r) => r.changePct === 0).length;  const totalAmountYi =    Math.round(snapshot.reduce((s, r) => s + r.amount, 0) / 1e6) / 100; // 鍏?鈫?浜垮厓  console.log(`  蹇収 ${snapshot.length} 鍙?| 娑?{upCount} 璺?{downCount} 骞?{flatCount} | 涓ゅ競鎴愪氦 ${totalAmountYi} 浜縛);  // ---------- 2. 鎸囨暟K绾匡細纭畾浜ゆ槗鏃ュ簭鍒?----------  console.log("[2/7] 鎷夊彇鎸囨暟K绾匡紙纭畾浜ゆ槗鏃ヤ笌鎸囨暟鏀剁洏锛?...");  const indexSeries = await fetchAllIndexKlines(60);  const sh = indexSeries.find((s) => s.code === "000001");  if (!sh || sh.bars.length < 5) throw new Error("涓婅瘉鎸囨暟K绾胯幏鍙栧け璐?);  const allDates = sh.bars.map((b) => b.date); // 鍗囧簭  const windowDates = allDates.slice(-backfillDays);  const preDates = allDates.slice(    Math.max(0, allDates.length - backfillDays - preWindowDays),    allDates.length - backfillDays  );  const latestDate = windowDates[windowDates.length - 1];  console.log(`  鏈€鏂颁氦鏄撴棩 ${latestDate}锛屽洖琛ョ獥鍙?${windowDates[0]} ~ ${latestDate}`);  // ---------- 3. 涓滆储娑ㄥ仠姹?鐐告澘姹?璺屽仠姹狅紙鏀寔鍘嗗彶鏃ユ湡锛?----------  console.log("[3/7] 鎷夊彇涓滆储娑ㄥ仠姹?鐐告澘姹?璺屽仠姹?...");  const poolsByDate = await fetchAllPools(windowDates.map((d) => d.replace(/-/g, "")));  const latestPools = poolsByDate.get(latestDate.replace(/-/g, ""));  if (!latestPools || (latestPools.zt.length === 0 && latestPools.zb.length === 0)) {    throw new Error(`娑ㄥ仠姹犳暟鎹幏鍙栧け璐ワ紙${latestDate}锛夛紝璇锋鏌ユ暟鎹簮缃戠粶`);  }  // 琛屼笟鏄犲皠锛氭潵鑷墍鏈夋睜瀛愯锛堥鏉愯仛绫荤殑鏁版嵁鏉ユ簮锛屽姩鎬佽幏鍙栵級  const industryByCode = new Map<string, string>();  for (const p of poolsByDate.values()) {    for (const row of [...p.zt, ...p.zb, ...p.dt]) {      if (row.industry) industryByCode.set(row.code, row.industry);    }  }  // ---------- 4. 姹犲唴鑲＄エ鍘婚噸 鈫?鎷夊彇鏃锛堜笉澶嶆潈锛岃嚜涓诲垽瀹氱敤锛?----------  console.log("[4/7] 鎷夊彇姹犲唴鑲＄エ鍘嗗彶K绾?...");  const poolCodes = new Set<string>();  for (const p of poolsByDate.values()) {    for (const row of [...p.zt, ...p.zb, ...p.dt]) poolCodes.add(row.code);  }  console.log(`  鍘婚噸鍚?${poolCodes.size} 鍙偂绁╜);  const klineMaps = await fetchKlineBatch([...poolCodes], klineBars, 6);  const klineMeta = new Map<string, KlineMeta>();  for (const [code, bars] of klineMaps) {    klineMeta.set(code, {      bars,      barByDate: new Map(bars.map((b) => [b.date, b])),    });  }  const klineFail = [...poolCodes].filter((c) => (klineMaps.get(c)?.length ?? 0) === 0).length;  if (klineFail > 0) console.warn(`  ${klineFail} 鍙偂绁↘绾胯幏鍙栧け璐ワ紙杩炴澘鏁板皢渚濊禆姹犲瓙閾捐矾锛塦);  // ---------- 5. 瑙勫垯娉曟娴嬶紙鏂规绗叓姝ワ細涓嶇洿鎺ョ浉淇℃暟鎹簮鐨勮繛鏉挎暟锛?----------  console.log("[5/7] 瑙勫垯娉曢€愭棩娑ㄥ仠/鐐告澘/璺屽仠妫€娴嬪苟鍚堝苟鍚嶅崟 ...");  const ruleDates = [...preDates, ...windowDates]; // 绉嶅瓙鏈?+ 绐楀彛鏈?  type Roster = { zt: Set<string>; zb: Set<string>; dt: Set<string> };  const ruleRosters = new Map<string, Roster>();  for (const d of ruleDates) ruleRosters.set(d, { zt: new Set(), zb: new Set(), dt: new Set() });  for (const [code, meta] of klineMeta) {    if (meta.bars.length === 0) continue;    const name = nameMap.get(code) ?? code;    for (let i = 1; i < meta.bars.length; i++) {      const bar = meta.bars[i];      const roster = ruleRosters.get(bar.date);      if (!roster) continue; // K绾垮惈绐楀彛澶栨棩鏈燂紝璺宠繃      const prev = meta.bars[i - 1];      const status = detectBarStatus(code, name, prev.close, bar);      if (!status) continue;      const key = status === "limitUp" ? "zt" : status === "broken" ? "zb" : "dt";      roster[key].add(code);    }  }  // 鍚堝苟鍚嶅崟锛氱獥鍙ｆ湡 = 鏁版嵁婧愭睜 鈭?瑙勫垯妫€娴嬶紱绉嶅瓙鏈?= 浠呰鍒欐娴?  const mergedRosters = new Map<string, Set<string>>();  for (const d of ruleDates) {    const rule = ruleRosters.get(d)!;    const set = new Set<string>([...rule.zt]);    if (windowDates.includes(d)) {      const p = poolsByDate.get(d.replace(/-/g, ""));      if (p) for (const row of p.zt) set.add(row.code);    }    mergedRosters.set(d, set);  }  // ---------- 6. 杩炴澘閾捐矾璁＄畻锛堣嚜涓荤姸鎬佹満锛?----------  console.log("[6/7] 璁＄畻杩炴澘閾捐矾 / 鏅嬬骇鐜?...");  const chain = computeBoardChain(ruleDates, mergedRosters, nameMap);  // 浜ゅ弶楠岃瘉锛氳嚜涓昏繛鏉挎暟 vs 鏁版嵁婧愬弬鑰冭繛鏉挎暟  let boardMismatch = 0;  for (const d of windowDates) {    const p = poolsByDate.get(d.replace(/-/g, ""));    if (!p) continue;    const dayStates = chain.byDate.get(d);    for (const row of p.zt) {      const own = dayStates?.get(row.code)?.boardCount ?? 0;      if (row.sourceBoardCount > 0 && own > 0 && row.sourceBoardCount !== own) {        boardMismatch++;        console.warn(          `  [鏍￠獙] ${d} ${row.code} ${row.name}: 鑷富=${own}鏉? 鏁版嵁婧?${row.sourceBoardCount}鏉匡紙浠ヨ嚜涓昏绠椾负鍑嗭級`        );      }    }  }  // ---------- 7. 鍏ュ簱锛堝厛鍒犲悗鍐欙紝骞傜瓑锛?----------  console.log("[7/7] 鏍囧噯鍖栧叆搴?...");  const ymd = (d: string) => d.replace(/-/g, "");  // 7.1 鑲＄エ鍩虹淇℃伅锛堝惈鎷奸煶棣栧瓧姣嶏紝鎼滅储鐢級  for (const batch of chunk(snapshot, 500)) {    for (const r of batch) {      await db.stockBasic.upsert({        where: { stockCode: r.code },        create: {          stockCode: r.code,          stockName: r.name,          market: marketOf(r.code),          industry: industryByCode.get(r.code) ?? null,          nameAbbr: nameAbbrOf(r.name),        },        update: {          stockName: r.name,          industry: industryByCode.get(r.code) ?? undefined,          nameAbbr: nameAbbrOf(r.name),        },      });    }  }  // 棰樻潗涓昏〃 + 鍏宠仈琛紙鍔ㄦ€侀噰闆嗭紝闈炵‖缂栫爜锛?  const conceptNames = [...new Set(industryByCode.values())].filter(Boolean);  for (const name of conceptNames) {    await db.concept.upsert({ where: { conceptName: name }, create: { conceptName: name }, update: {} });  }  const conceptIdByName = new Map<string, number>();  for (const c of await db.concept.findMany()) conceptIdByName.set(c.conceptName, c.id);  for (const [code, ind] of industryByCode) {    const cid = conceptIdByName.get(ind);    if (!cid) continue;    await db.stockConcept.upsert({      where: { stockCode_conceptId: { stockCode: code, conceptId: cid } },      create: { stockCode: code, conceptId: cid, source: "eastmoney-hybk" },      update: {},    });  }  // 7.2 娓呯悊鏃ф暟鎹紙骞傜瓑锛夆€斺€?鎵€鏈夎〃 tradeDate 缁熶竴涓?YYYY-MM-DD 鏍煎紡  const dateStrs = windowDates;  for (const model of [    db.limitUp, db.brokenLimit, db.limitDown, db.dailyStock,    db.boardHistory, db.dailyConcept, db.sentimentDaily, db.dailyMarket,  ]) {    await model.deleteMany({ where: { tradeDate: { in: dateStrs } } });  }  // 7.3 姣忔棩琛屾儏鏄庣粏锛圖ailyStock锛屼粎姹犲唴鑲＄エ锛?  interface DailyStockRow {    tradeDate: string; stockCode: string; open: number; high: number; low: number; close: number;    prevClose: number; changePct: number; volume: number; amount: number | null;    turnoverRate: number | null; floatMarketCap: number | null;    isLimitUp: boolean; isLimitDown: boolean; isBroken: boolean;  }  const dailyStockRows: DailyStockRow[] = [];  const poolRowBy = new Map<string, EmPoolStock>(); // `${date}:${code}` -> pool row  for (const d of windowDates) {    const p = poolsByDate.get(ymd(d))!;    for (const row of p.zt) poolRowBy.set(`${d}:${row.code}`, row);    for (const row of p.zb) poolRowBy.set(`${d}:${row.code}`, row);    for (const row of p.dt) poolRowBy.set(`${d}:${row.code}`, row);  }  const seenStockDate = new Set<string>();  for (const code of poolCodes) {    const meta = klineMeta.get(code);    if (!meta) continue;    for (let i = 1; i < meta.bars.length; i++) {      const bar = meta.bars[i];      if (!windowDates.includes(bar.date)) continue;      const dedupeKey = `${bar.date}:${code}`;      if (seenStockDate.has(dedupeKey)) continue; // 闃插尽锛欿绾垮伓鍙戦噸澶嶆棩鏈?      seenStockDate.add(dedupeKey);      const prev = meta.bars[i - 1];      const poolRow = poolRowBy.get(`${bar.date}:${code}`);      const pct = ((bar.close / prev.close - 1) * 100) as number;      const isLatest = bar.date === latestDate;      const snap = snapByCode.get(code);      // 鎴愪氦棰濓細姹犲瓙绮剧‘鍊?> K绾跨湡瀹炲€?> 蹇収绮剧‘鍊?> 鍏稿瀷浠蜂及绠?      const amount =        poolRow?.amount ??        bar.amount ??        (isLatest && snap ? snap.amount : Math.round(bar.volume * 100 * ((bar.open + bar.high + bar.low + bar.close) / 4)));      const turnoverRate = poolRow?.turnoverRate ?? (isLatest && snap ? snap.turnoverRate : null);      const floatMarketCap = poolRow?.floatMarketCap ?? (isLatest && snap ? snap.floatMarketCap : null);      dailyStockRows.push({        tradeDate: bar.date,        stockCode: code,        open: bar.open, high: bar.high, low: bar.low, close: bar.close,        prevClose: prev.close,        changePct: Math.round(pct * 100) / 100,        volume: bar.volume,        amount,        turnoverRate: turnoverRate ?? null,        floatMarketCap: floatMarketCap ?? null,        volumeRatio: volumeRatioAt(meta, bar.date),        isLimitUp: mergedRosters.get(bar.date)!.has(code),        isLimitDown: ruleRosters.get(bar.date)!.dt.has(code) || (poolsByDate.get(ymd(bar.date))?.dt.some((r) => r.code === code) ?? false),        isBroken: ruleRosters.get(bar.date)!.zb.has(code) || (poolsByDate.get(ymd(bar.date))?.zb.some((r) => r.code === code) ?? false),      });    }  }  for (const batch of chunk(dailyStockRows, 400)) await db.dailyStock.createMany({ data: batch, skipDuplicates: true });  // 7.4 娑ㄥ仠 / 鐐告澘 / 璺屽仠鏄庣粏 + 杩炴澘鍘嗗彶  const limitUpRows: Parameters<typeof db.limitUp.createMany>[0]["data"] = [];  const brokenRows: Parameters<typeof db.brokenLimit.createMany>[0]["data"] = [];  const limitDownRows: Parameters<typeof db.limitDown.createMany>[0]["data"] = [];  const boardHistRows: Parameters<typeof db.boardHistory.createMany>[0]["data"] = [];  for (const d of windowDates) {    const p = poolsByDate.get(ymd(d))!;    const rule = ruleRosters.get(d)!;    const states = chain.byDate.get(d)!;    const mkLimitUp = (row: EmPoolStock) => {      const st = states.get(row.code);      return {        tradeDate: d, stockCode: row.code, stockName: row.name,        limitPrice: row.limitPrice > 0 ? row.limitPrice : row.price,        closePrice: row.price, changePct: row.changePct,        firstLimitTime: row.firstLimitTime, lastLimitTime: row.lastLimitTime,        openCount: row.openCount, sealAmount: row.sealFund > 0 ? row.sealFund : null,        amount: row.amount > 0 ? row.amount : null,        turnoverRate: row.turnoverRate > 0 ? row.turnoverRate : null,        floatMarketCap: row.floatMarketCap > 0 ? row.floatMarketCap : null,        industry: row.industry || null,        boardCount: st?.boardCount ?? 1,        volumeRatio: volumeRatioAt(klineMeta.get(row.code), d),        themes: JSON.stringify(matchThemes(row.name, row.industry)),        sourceBoard: row.sourceBoardCount > 0 ? row.sourceBoardCount : null,        daysAndBoards: row.days > 0 ? `${row.days}澶?{row.boards}鏉縛 : null,        isPromotion: st?.isPromotion ?? false,        isRebound: st?.isRebound ?? false,      };    };    for (const row of p.zt) limitUpRows.push(mkLimitUp(row));    // 瑙勫垯妫€鍑轰絾姹犲瓙閬楁紡鐨勬定鍋滐紙琛ュ綍锛?    for (const code of rule.zt) {      if (p.zt.some((r) => r.code === code)) continue;      const meta = klineMeta.get(code)!;      const bar = meta.barByDate.get(d);      const prev = meta.bars[meta.bars.findIndex((b) => b.date === d) - 1];      if (!bar || !prev) continue;      const name = nameMap.get(code) ?? code;      const pct = limitPctOf(code, name);      const st = states.get(code);      limitUpRows.push({        tradeDate: d, stockCode: code, stockName: name,        limitPrice: limitUpPriceOf(prev.close, pct), closePrice: bar.close,        changePct: Math.round(((bar.close / prev.close - 1) * 100) * 100) / 100,        firstLimitTime: bar.open === limitUpPriceOf(prev.close, pct) ? "09:25:00" : null,        lastLimitTime: null, openCount: 0, sealAmount: null,        amount: Math.round(bar.volume * 100 * ((bar.open + bar.high + bar.low + bar.close) / 4)),        turnoverRate: null, floatMarketCap: null,        industry: industryByCode.get(code) ?? null,        themes: JSON.stringify(matchThemes(name, industryByCode.get(code) ?? null)),        boardCount: st?.boardCount ?? 1, volumeRatio: volumeRatioAt(meta, d), sourceBoard: null, daysAndBoards: null,        isPromotion: st?.isPromotion ?? false, isRebound: st?.isRebound ?? false,      });    }    for (const row of p.zb) {      const st = states.get(row.code);      brokenRows.push({        tradeDate: d, stockCode: row.code, stockName: row.name,        limitPrice: row.limitPrice > 0 ? row.limitPrice : limitUpPriceOf(row.price, limitPctOf(row.code, row.name)),        closePrice: row.price, changePct: row.changePct,        firstLimitTime: row.firstLimitTime, openCount: row.openCount,        amount: row.amount > 0 ? row.amount : null,        turnoverRate: row.turnoverRate > 0 ? row.turnoverRate : null,        floatMarketCap: row.floatMarketCap > 0 ? row.floatMarketCap : null,        industry: row.industry || null,        volumeRatio: volumeRatioAt(klineMeta.get(row.code), d),      });      void st;    }    for (const row of p.dt) {      limitDownRows.push({        tradeDate: d, stockCode: row.code, stockName: row.name,        limitPrice: limitDownPriceOf(row.price / (1 + row.changePct / 100), limitPctOf(row.code, row.name)),        closePrice: row.price, changePct: row.changePct,        brokeCount: row.openCount,        continuousDays: row.continuousDownDays > 0 ? row.continuousDownDays : null,        amount: row.amount > 0 ? row.amount : null,        industry: row.industry || null,      });    }    // 杩炴澘鍘嗗彶锛堝惈鏂澘璁板綍 boardCount=0锛?    for (const st of states.values() as IterableIterator<BoardState>) {      if (st.boardCount === 0 && !st.isBreak) continue;      boardHistRows.push({        tradeDate: d, stockCode: st.stockCode, stockName: st.stockName,        boardCount: st.boardCount, previousBoardCount: st.previousBoardCount,        isPromotion: st.isPromotion, isBreak: st.isBreak, isRebound: st.isRebound,      });    }  }  // ---------- 7.4.2 涓偂鏂伴椈璇佹嵁锛堟渶鏂颁氦鏄撴棩娑ㄥ仠鑲★細鏂伴椈鍙備笌棰樻潗褰掔被锛?----------  // 鐢ㄦ埛鏂规硶璁猴細涓嶈兘鍏夌湅琛屼笟鍒嗙被鈥斺€旇鐪嬭偂绁ㄤ笅闈㈢殑鐩稿叧鏂伴椈鍐嶅綊绫汇€?  // 鏂伴椈鍛戒腑涓荤嚎鍏抽敭璇?鈫?鈶犱綈璇?鏂板璇ヨ偂涓荤嚎褰掑睘锛坢erge 杩?themes锛?  //                    鈶¤瘉鎹槑缁嗚惤 LimitUp.themeEvidence锛堝彲瑙ｉ噴锛?  //                    鈶㈡柊闂诲叆搴?NewsItem(kind=stock) 鎸傚埌涓荤嚎涓嬶紙涓荤嚎鏂伴椈娴侊級  console.log("[7.4b] 涓偂鏂伴椈 鈫?棰樻潗褰掔被璇佹嵁锛堟渶鏂颁氦鏄撴棩娑ㄥ仠鑲★級 ...");  let stockNewsCount = 0;  let evidenceStocks = 0;  let themeMerged = 0;  {    const [yy, mm, dd] = latestDate.split("-").map(Number);    const nextDayDate = new Date(Date.UTC(yy, mm - 1, dd + 1)).toISOString().slice(0, 10);    const dayStart = `${latestDate} 00:00:00`;    const dayEnd = `${nextDayDate} 23:59:59`; // 褰撴棩+娆℃棩锛氱洏鍚?娆℃棩鏃╅棿鏂伴椈鍚屾牱鏀拺褰撴棩褰掔被    const latestLuRows = limitUpRows.filter((r) => r.tradeDate === latestDate);    const fetched = await pmap(latestLuRows, 3, async (row) => {      try {        const news = await fetchStockNews(row.stockName, { since: dayStart, until: dayEnd, take: 8 });        await sleep(120); // 瀵规暟鎹簮闄愰€?        return { row, news };      } catch {        return { row, news: [] as StockNewsItem[] };      }    });    const newsRowsToInsert: Parameters<typeof db.newsItem.createMany>[0]["data"] = [];    for (const { row, news } of fetched) {      if (news.length === 0) continue;      stockNewsCount += news.length;      const inherited = parseThemes(row.themes);      const evidence: { theme: string; hits: string[]; title: string; media: string; time: string }[] = [];      const extraThemes = new Set<string>();      for (const it of news) {        const text = `${it.title} ${it.summary}`;        const detail = matchThemesInTextDetailed(text);        const { impact } = analyzeImpact(text);        for (const d of detail) {          evidence.push({ theme: d.theme, hits: d.hits, title: it.title, media: it.media, time: it.pubTime });          if (!inherited.includes(d.theme)) extraThemes.add(d.theme);        }        // 涓荤嚎鏂伴椈娴侊細涓偂鏂伴椈鎸?鏂伴椈鍛戒腑涓荤嚎 鈭?璇ヨ偂褰撴棩涓荤嚎锛堝揩璁祦涔嬪鐨勫閲忥級        const newsThemes = [...new Set([...detail.map((d) => d.theme), ...inherited])];        const hash = createHash("md5")          .update(it.url || `${row.stockCode}-${it.title}`)          .digest("hex")          .slice(0, 16);        newsRowsToInsert.push({          extId: `em:${row.stockCode}:${hash}`,          pubTime: it.pubTime,          content: `${it.title}${it.summary ? `锛?{it.summary}` : ""}`.slice(0, 400),          source: "eastmoney-search",          kind: "stock",          impact,          themes: newsThemes.length ? JSON.stringify(newsThemes) : null,          stocks: JSON.stringify([            { market: "cn", symbol: txCode(row.stockCode), key: normalizeStockName(row.stockName) },          ]),        });      }      if (evidence.length > 0) {        evidenceStocks++;        row.themeEvidence = JSON.stringify(evidence.slice(0, 6));      }      if (extraThemes.size > 0) {        themeMerged += extraThemes.size;        row.themes = JSON.stringify([...inherited, ...extraThemes]);      }    }    // 鍏ュ簱涓偂鏂伴椈锛坋xtId 鍞竴锛岄噸澶嶉噰闆嗗箓绛夛級    for (const batch of chunk(newsRowsToInsert, 200)) {      for (const n of batch) {        await db.newsItem.upsert({ where: { extId: n.extId }, create: n, update: {} });      }    }    // 涓偂鏂伴椈瑁佸壀锛氫粎淇濈暀鏈€杩?600 鏉★紙涓庡揩璁祦 500 鏉¤鍓嫭绔嬶級    const stockTotal = await db.newsItem.count({ where: { kind: "stock" } });    if (stockTotal > 600) {      const old = await db.newsItem.findMany({        where: { kind: "stock" },        orderBy: [{ pubTime: "desc" }, { id: "desc" }],        skip: 600,        select: { id: true },      });      if (old.length > 0) await db.newsItem.deleteMany({ where: { id: { in: old.map((r) => r.id) } } });    }    console.log(      `  瑕嗙洊 ${fetched.filter((x) => x.news.length > 0).length}/${latestLuRows.length} 鍙?| 鏂伴椈鍏ュ簱 ${stockNewsCount} 鏉?| 鏂伴椈璇佹嵁 ${evidenceStocks} 鍙?| 鏂板褰掑睘 ${themeMerged} 澶刞    );  }  for (const batch of chunk(limitUpRows, 400)) await db.limitUp.createMany({ data: batch, skipDuplicates: true });  for (const batch of chunk(brokenRows, 400)) await db.brokenLimit.createMany({ data: batch, skipDuplicates: true });  for (const batch of chunk(limitDownRows, 400)) await db.limitDown.createMany({ data: batch, skipDuplicates: true });  for (const batch of chunk(boardHistRows, 400)) await db.boardHistory.createMany({ data: batch, skipDuplicates: true });  // ---------- 7.4.5 鐖嗛噺姒滐紙鍚潪娑ㄥ仠鏍囩殑锛?----------  // 鍙ｅ緞锛氭寮?volumeRatioAt锛堝綋鏃ユ垚浜ら噺/鍓?0鏃ュ潎閲忥級鈮?锛屼笌娑ㄥ仠姹犲畬鍏ㄤ竴鑷淬€?  // 棰勭瓫鍙岄€氶亾锛堟椂鐐规棤鍏筹細鐩樺墠/鐩樹腑琛ラ噰鏃跺叏甯傚満蹇収閲忔瘮鏃犳晥锛屾睜鍐呯簿绠楀厹搴曪級锛?  //   鈶?鑵捐鍏ㄥ競鍦哄揩鐓ч噺姣斺墺1.5 鍙栧墠120锛堣繍琛屾椂鏈夋晥鍒欒鐩栭潪娑ㄥ仠鐖嗛噺鑲★級  //   鈶?姹犲唴鑲＄エ锛圞绾垮凡鍦ㄦ墜锛夌洿鎺?volumeRatioAt 鈮?.5锛堟定鍋?鐐告澘鐖嗛噺鑲″繀涓嶉仐婕忥級  console.log("[7.5] 鐖嗛噺鍊欓€夎绠楋紙蹇収+姹犲唴鍙岄绛涳紝鍚潪娑ㄥ仠锛?...");  const SURGE_PREFILTER_RATIO = 1.5;  const SURGE_CANDIDATE_LIMIT = 120;  const SURGE_RATIO_MIN = 2;  const ztSetLatest = mergedRosters.get(latestDate)!;  const zbSetLatest = new Set<string>([    ...ruleRosters.get(latestDate)!.zb,    ...(poolsByDate.get(ymd(latestDate))?.zb.map((r) => r.code) ?? []),  ]);  const snapSurgeCands = snapshot    .filter((r) => r.volumeRatio >= SURGE_PREFILTER_RATIO && r.price > 0)    .sort((a, b) => b.volumeRatio - a.volumeRatio)    .slice(0, SURGE_CANDIDATE_LIMIT);  const poolSurgeCands: string[] = [];  for (const [code, meta] of klineMeta) {    const r = volumeRatioAt(meta, latestDate);    if (r != null && r >= SURGE_PREFILTER_RATIO) poolSurgeCands.push(code);  }  const surgeCodes = new Set<string>([...snapSurgeCands.map((r) => r.code), ...poolSurgeCands]);  console.log(    `  閲忔瘮棰勭瓫锛氬揩鐓?${snapSurgeCands.length} 鍙?+ 姹犲唴绮剧畻 ${poolSurgeCands.length} 鍙?鈫?鍘婚噸 ${surgeCodes.size} 鍙?鈫?20鏃ュ彛寰勭簿绠梎  );  const surgeKlines = await fetchKlineBatch(    [...surgeCodes].filter((c) => !klineMeta.has(c)),    100,    6  );  for (const [code, bars] of surgeKlines) {    if (bars.length > 0 && !klineMeta.has(code)) {      klineMeta.set(code, { bars, barByDate: new Map(bars.map((b) => [b.date, b])) });    }  }  // 褰撴棩 DailyStock 琛岋紙K绾挎棩 bar锛屾椂鐐规棤鍏筹級锛氫环鏍?娑ㄨ穼骞呬竴寰嬪彇姝わ紱蹇収浠呭湪鏁板€兼湁鏁堟椂琛ュ厖鎴愪氦棰?鎹㈡墜/甯傚€?  const dsLatestByCode = new Map(    dailyStockRows.filter((r) => r.tradeDate === latestDate).map((r) => [r.stockCode, r])  );  const surgeRows: Parameters<typeof db.volumeSurge.createMany>[0]["data"] = [];  for (const code of surgeCodes) {    const meta = klineMeta.get(code);    const ratio = volumeRatioAt(meta, latestDate);    if (ratio == null || ratio < SURGE_RATIO_MIN) continue;    const idx = meta!.bars.findIndex((b) => b.date === latestDate);    if (idx < 0) continue; // 褰撴棩鏃燢绾匡紙鍋滅墝绛夛級    const bar = meta!.bars[idx];    const prevBar = idx > 0 ? meta!.bars[idx - 1] : undefined;    // 浠锋牸/娑ㄨ穼骞呭彇 K绾挎棩 bar锛堟椂鐐规棤鍏筹細鐩樺墠琛ラ噰蹇収浠峰仠鍦ㄦ槰鏀躲€侀噺姣旀棤鏁堜篃鑳界畻瀵癸級    const price = bar.close;    if (price <= 0) continue;    const changePct =      prevBar && prevBar.close > 0        ? Math.round((bar.close / prevBar.close - 1) * 10000) / 100        : dsLatestByCode.get(code)?.changePct ?? 0;    const snap = snapByCode.get(code);    const name = nameMap.get(code) ?? "";    const ds = dsLatestByCode.get(code);    const amount = snap && snap.amount > 0 ? snap.amount : bar.amount && bar.amount > 0 ? bar.amount : ds?.amount ?? null;    const turnoverRate =      snap && snap.turnoverRate > 0 ? snap.turnoverRate : ds?.turnoverRate && ds.turnoverRate > 0 ? ds.turnoverRate : null;    const floatMarketCap =      snap && snap.floatMarketCap > 0 ? snap.floatMarketCap : ds?.floatMarketCap && ds.floatMarketCap > 0 ? ds.floatMarketCap : null;    const win = meta!.bars.slice(Math.max(0, idx - 59), idx + 1);    const high60 = Math.max(...win.map((b) => b.high));    const low60 = Math.min(...win.map((b) => b.low));    const distFromHigh60 = Math.round(((high60 - price) / high60) * 10000) / 100;    const distFromLow60 = Math.round(((price - low60) / low60) * 10000) / 100;    const position = distFromHigh60 <= 10 ? "high" : distFromHigh60 >= 30 ? "low" : "mid";    const industry = industryByCode.get(code) ?? null;    surgeRows.push({      tradeDate: latestDate, stockCode: code, stockName: name,      close: price, changePct, volumeRatio: ratio,      amount,      turnoverRate,      floatMarketCap,      industry,      themes: JSON.stringify(matchThemes(name, industry)),      isLimitUp: ztSetLatest.has(code),      isBroken: zbSetLatest.has(code),      position, distFromHigh60, distFromLow60,    });  }  console.log(    `  鐖嗛噺鍏ラ€?${surgeRows.length} 瀹讹紙娑ㄥ仠 ${surgeRows.filter((r) => r.isLimitUp).length} / 闈炴定鍋?${      surgeRows.filter((r) => !r.isLimitUp).length    } 路 楂樹綅 ${surgeRows.filter((r) => r.position === "high").length} / 浣庝綅 ${      surgeRows.filter((r) => r.position === "low").length    }锛塦  );  // 浠呮竻鐞嗗苟閲嶅啓鏈€鏂颁氦鏄撴棩锛堝巻鍙茬垎閲忎繚鐣欙紝渚?P2 鐖嗛噺鍚庤〃鐜扮粺璁★級  await db.volumeSurge.deleteMany({ where: { tradeDate: latestDate } });  for (const batch of chunk(surgeRows, 400)) await db.volumeSurge.createMany({ data: batch, skipDuplicates: true });  // 7.5 棰樻潗缁熻 + 鎯呯华鎸囨爣 + 甯傚満姹囨€?  const indexByDate = new Map<string, Record<string, { close: number; pct: number }>>();  // 鎸囨暟瀹樻柟鎴愪氦棰濓紙涓婅瘉鎸囨暟 + 娣辫瘉缁兼寚 = 娌繁涓ゅ競鎴愪氦棰濓紝鍙ｅ緞鍘嗗彶涓€鑷达級  const indexAmountByDate = new Map<string, number>();  for (const s of indexSeries as IndexSeries[]) {    for (let i = 1; i < s.bars.length; i++) {      const b = s.bars[i];      const rec = indexByDate.get(b.date) ?? {};      rec[s.code] = { close: b.close, pct: Math.round(((b.close / s.bars[i - 1].close - 1) * 100) * 100) / 100 };      indexByDate.set(b.date, rec);    }    if (s.code === "000001" || s.code === "399106") {      for (const b of s.bars) {        if (b.amount) indexAmountByDate.set(b.date, (indexAmountByDate.get(b.date) ?? 0) + b.amount);      }    }  }  const conceptRows: Parameters<typeof db.dailyConcept.createMany>[0]["data"] = [];  const sentimentRows: Parameters<typeof db.sentimentDaily.createMany>[0]["data"] = [];  const marketRows: Parameters<typeof db.dailyMarket.createMany>[0]["data"] = [];  for (const d of windowDates) {    const lu = limitUpRows.filter((r) => r.tradeDate === d);    const zb = brokenRows.filter((r) => r.tradeDate === d);    const dt = limitDownRows.filter((r) => r.tradeDate === d);    const sealRate = sealRateOf(lu.length, zb.length);    const brokenRate = brokenRateOf(lu.length, zb.length);    // 棰樻潗锛堝弻灞傦細琛屼笟缁嗗垎 + 涓荤嚎棰樻潗瑙勫垯褰掔粍锛?    const conceptStats = buildConceptStats(      lu.map((r) => ({        stockCode: r.stockCode, stockName: r.stockName,        industry: (r.industry as string) ?? "", boardCount: r.boardCount as number,        firstLimitTime: r.firstLimitTime as string | null, amount: r.amount as number | null,      })),      zb.map((r) => ({ industry: (r.industry as string) ?? "" }))    );    for (const c of conceptStats) {      conceptRows.push({ tradeDate: d, ...c, kind: "industry" });    }    const themeStats = buildThemeStats(      lu.map((r) => ({        stockCode: r.stockCode, stockName: r.stockName,        industry: (r.industry as string) ?? "", boardCount: r.boardCount as number,        firstLimitTime: r.firstLimitTime as string | null, amount: r.amount as number | null,        themes: parseThemes(r.themes as string | null | undefined), // 鍚柊闂昏瘉鎹悎骞跺悗鐨勫綊灞?      }))    );    for (const t of themeStats) {      const { members, ...rest } = t;      conceptRows.push({ tradeDate: d, ...rest, kind: "theme", members: JSON.stringify(members) });    }    // 鎯呯华    const states = chain.byDate.get(d)!;    const highestBoard = Math.max(0, ...[...states.values()].map((s) => s.boardCount));    const prevDate = ruleDates[ruleDates.indexOf(d) - 1];    let yesterdayLimitAvg: number | null = null;    let yesterdayCount: number | null = null;    let yesterdayRedCount: number | null = null;    if (prevDate) {      const prevRoster = mergedRosters.get(prevDate)!;      const pcts: number[] = [];      let red = 0;      for (const code of prevRoster) {        const meta = klineMeta.get(code);        const idx = meta?.bars.findIndex((b) => b.date === d) ?? -1;        if (!meta || idx <= 0) continue;        const pct = ((meta.bars[idx].close / meta.bars[idx - 1].close - 1) * 100) as number;        pcts.push(pct);        if (pct > 0) red++;      }      if (pcts.length > 0) {        yesterdayCount = prevRoster.size;        yesterdayRedCount = red;        yesterdayLimitAvg = Math.round((pcts.reduce((a, b) => a + b, 0) / pcts.length) * 100) / 100;      }    }    const promos = chain.promotionsByDate.get(d) ?? [];    const isLatest = d === latestDate;    const s = calcSentiment({      limitUpCount: lu.length, limitDownCount: dt.length, brokenCount: zb.length,      highestBoard, yesterdayLimitAvg,      upCount: isLatest ? upCount : null,      downCount: isLatest ? downCount : null,    });    sentimentRows.push({      tradeDate: d,      limitUpCount: lu.length, limitDownCount: dt.length, brokenLimitCount: zb.length,      sealRate: Math.round(sealRate * 10000) / 10000,      brokenRate: Math.round(brokenRate * 10000) / 10000,      highestBoard,      yesterdayLimitAvg, yesterdayCount, yesterdayRedCount,      promotionDetails: JSON.stringify(promos),      sentimentTemperature: s.temperature, sentimentStage: s.stage,      upCount: isLatest ? upCount : null,      downCount: isLatest ? downCount : null,    });    // 甯傚満姹囨€?    const idx = indexByDate.get(d) ?? {};    marketRows.push({      tradeDate: d,      shIndex: idx["000001"]?.close ?? null, shChangePct: idx["000001"]?.pct ?? null,      szIndex: idx["399001"]?.close ?? null, szChangePct: idx["399001"]?.pct ?? null,      cyIndex: idx["399006"]?.close ?? null, cyChangePct: idx["399006"]?.pct ?? null,      kcIndex: idx["000688"]?.close ?? null, kcChangePct: idx["000688"]?.pct ?? null,      sz50Index: idx["000016"]?.close ?? null, sz50ChangePct: idx["000016"]?.pct ?? null,      bz50Index: idx["899050"]?.close ?? null, bz50ChangePct: idx["899050"]?.pct ?? null,      totalAmount: indexAmountByDate.has(d)        ? Math.round(indexAmountByDate.get(d)! / 1e6) / 100        : isLatest ? totalAmountYi : null,      upCount: isLatest ? upCount : null,      downCount: isLatest ? downCount : null,      flatCount: isLatest ? flatCount : null,      limitUpCount: lu.length, limitDownCount: dt.length, brokenCount: zb.length,      sealRate: Math.round(sealRate * 10000) / 10000,      dataSource: "eastmoney+qq",    });  }  for (const batch of chunk(conceptRows, 400)) await db.dailyConcept.createMany({ data: batch, skipDuplicates: true });  for (const batch of chunk(sentimentRows, 400)) await db.sentimentDaily.createMany({ data: batch, skipDuplicates: true });  await db.dailyMarket.createMany({ data: marketRows, skipDuplicates: true });  // ---------- 閲囬泦鏃ュ織 ----------  const latestStates = chain.byDate.get(latestDate)!;  const latestLu = limitUpRows.filter((r) => r.tradeDate === latestDate);  const latestSent = sentimentRows.find((r) => r.tradeDate === latestDate)!;  const summary: CollectSummary = {    latestDate,    tradeDates: windowDates,    stockCount: snapshot.length,    limitUpCount: latestLu.length,    brokenCount: latestPools.zb.length,    limitDownCount: latestPools.dt.length,    firstBoardCount: latestLu.filter((r) => (r.boardCount as number) === 1).length,    lianbanCount: latestLu.filter((r) => (r.boardCount as number) >= 2).length,    highestBoard: Math.max(0, ...[...latestStates.values()].map((x) => x.boardCount)),    totalAmountYi,    upCount, downCount,    sealRate: sealRateOf(latestLu.length, latestPools.zb.length),    temperature: latestSent.sentimentTemperature as number,    stage: latestSent.sentimentStage as string,    boardMismatch,    stockNewsCount,    evidenceStocks,    themeMerged,    durationMs: Date.now() - startedAt,  };  await db.collectLog.create({    data: {      tradeDates: `${windowDates[0]}~${latestDate}`,      source: "eastmoney+qq",      stockCount: snapshot.length,      limitUpCount: summary.limitUpCount,      durationMs: summary.durationMs,      status: "success",      message: JSON.stringify({        broken: summary.brokenCount, highestBoard: summary.highestBoard,        mismatch: summary.boardMismatch,        stockNews: summary.stockNewsCount, evidenceStocks: summary.evidenceStocks,        themeMerged: summary.themeMerged,      }),    },  });  // 楠屾敹娓呭崟鎴愪氦棰濅笌鏁版嵁搴撳彛寰勪竴鑷达紙鎸囨暟瀹樻柟鍙ｅ緞锛?  const latestMarketRow = marketRows.find((r) => r.tradeDate === latestDate);  if (latestMarketRow && typeof latestMarketRow.totalAmount === "number") {    summary.totalAmountYi = latestMarketRow.totalAmount;  }  return summary;}